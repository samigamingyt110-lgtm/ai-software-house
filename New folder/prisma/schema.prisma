// AI Software House - Core Data Model (Milestone 1)
// This is intentionally minimal. Each department milestone will extend it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentDepartment {
  SALES
  PROJECT_MANAGEMENT
  DEVELOPMENT
  FINANCE
  SUPPORT
}

enum AgentStatus {
  IDLE
  WORKING
  WAITING_APPROVAL
  ERROR
  DISABLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

// The AI "employees". Each row is a configured agent instance, not a live process.
model Agent {
  id          String          @id @default(cuid())
  name        String
  department  AgentDepartment
  status      AgentStatus     @default(IDLE)
  description String?
  lastActiveAt DateTime?
  createdAt   DateTime        @default(now())
  logs        AgentLog[]
  approvals   ApprovalRequest[]
}

model AgentLog {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
}

// Anything an agent wants to do that crosses a configured limit
// (accepting a deal, sending an outbound message, finalizing a price, etc.)
// waits here until the CEO approves or rejects it.
model ApprovalRequest {
  id          String         @id @default(cuid())
  agentId     String?
  agent       Agent?         @relation(fields: [agentId], references: [id])
  title       String
  description String
  payload     Json?
  status      ApprovalStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
}

model Client {
  id        String    @id @default(cuid())
  name      String
  company   String?
  email     String?
  source    String?   // where the lead came from
  score     Int?      // lead quality score
  createdAt DateTime  @default(now())
  projects  Project[]
  invoices  Invoice[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  status      ProjectStatus @default(PENDING)
  budget      Decimal?      @db.Decimal(12, 2)
  startedAt   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  tasks       ProjectTask[]
  invoices    Invoice[]
}

model ProjectTask {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  title      String
  assignedTo String?  // department or agent name
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  channel   String   @default("dashboard") // dashboard | telegram
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Company {
  id            String   @id @default(cuid())
  name          String
  mission       String
  industry      String
  stage         String
  monthlyGoals  String
  tools         String
  brandContext  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
